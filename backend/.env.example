# Deployment environment: development | staging | production.
# Anything other than "development" requires ORIGOTEXT_API_KEYS to be set,
# and the app refuses to start without it.
ORIGOTEXT_ENVIRONMENT=development

# Comma-separated API keys accepted in the X-API-Key header.
# Each key must be at least 32 characters outside development.
# Source these from a secret manager; never commit real values.
ORIGOTEXT_API_KEYS=

# Comma-separated browser origins allowed by CORS.
ORIGOTEXT_ALLOWED_ORIGINS=http://localhost:3000

# Per-key request budgets, counted over a rolling 60-second window.
ORIGOTEXT_RATE_LIMIT_PER_MINUTE=30
ORIGOTEXT_UPLOAD_RATE_LIMIT_PER_MINUTE=10
