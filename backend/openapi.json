              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run a plagiarism check against the licensed corpus",
        "tags": [
          "plagiarism"
        ]
      }
    }
  }
}
