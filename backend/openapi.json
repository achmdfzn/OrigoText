  "info": {
    "description": "Academic Intelligence Platform \u2014 plagiarism and AI-detection services",
    "title": "OrigoText API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "ops"
        ]
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Readyz Readyz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readyz",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/ai-detection/analyze": {
      "post": {
        "operationId": "analyze_v1_ai_detection_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DetectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetectionResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Analyze text for AI-generated content",
        "tags": [
          "ai-detection"
        ]
      }
    },
    "/v1/documents": {
      "post": {
        "operationId": "create_document_v1_documents_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_document_v1_documents_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParseResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Empty or unreadable document"
          },
          "413": {
            "content": {
              "application/problem+json": {}
            },
            "description": "File exceeds the upload size limit"
          },
          "415": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Unsupported document format"
          },
          "422": {
            "content": {
              "application/problem+json": {}
            },
            "description": "No extractable text (may require OCR)"
          }
        },
        "summary": "Upload and parse a document into structured, sanitized text",
        "tags": [
          "documents"
        ]
      }
    },
    "/v1/plagiarism/checks": {
      "post": {
        "operationId": "create_check_v1_plagiarism_checks_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckRequest"
