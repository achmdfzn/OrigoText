# Base URL of the OrigoText FastAPI backend.
# Must be reachable from the browser, since analysis calls run client-side.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# API key sent as X-API-Key with every analysis request.
# NEXT_PUBLIC_ values ship to the browser and are visible to any user, so this
# is a deployment-scoped key for gating the public surface, never a per-user
# secret. Leave unset when the backend runs in development mode.
# Per-user credentials require a server-side proxy so the key stays on the server.
NEXT_PUBLIC_API_KEY=
