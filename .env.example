# FastAPI URL reachable from the Next.js server. Never expose this as a
# NEXT_PUBLIC_ variable; browser requests go through same-origin /api routes.
ORIGOTEXT_API_BASE_URL=http://localhost:8000

# Server-only key inserted by the Next.js BFF as X-API-Key. Leave unset while
# FastAPI runs in development mode without configured keys.
ORIGOTEXT_API_KEY=

# BFF-to-FastAPI timeout in milliseconds.
ORIGOTEXT_API_TIMEOUT_MS=35000
